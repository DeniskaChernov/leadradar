# Safe staging values, not a live deployment. Add secrets using Railway Variables.
# Attach a persistent volume at /data and upload a verified SQLite snapshot first.
DATABASE_URL=sqlite+aiosqlite:////data/lead_radar.db
WEB_HOST=0.0.0.0
PORT=8000
WEB_AUTH_ENABLED=true
# Replace this placeholder with the actual Railway-generated hostname.
WEB_PUBLIC_URL=https://REPLACE-WITH-GENERATED-HOST.up.railway.app
DATABASE_BACKUP_ON_START=true
DATABASE_BACKUP_KEEP=10
LOG_FORMAT=json

# Keep staging offline. Restore the approved live settings only after cutover.
EXTERNAL_KILL_SWITCH=true
EXTERNAL_LIVE_UNLOCK=
INSTAGRAM_PROVIDER=replay
INSTAGRAM_LIVE_CALLS_ENABLED=false
INSTAGRAM_MANUAL_LIVE_SCAN_ONLY=true
LEAD_SEARCH_ENABLED=false
MONITOR_SCHEDULE_ENABLED=false
AI_PENDING_RETRY_ENABLED=false
OPENAI_LIVE_CALLS_ENABLED=false

# Reuse existing credentials and roles privately; do not paste them into this file.
# TELEGRAM_BOT_TOKEN, TELEGRAM_ADMIN_CHAT_IDS, TELEGRAM_MANAGER_CHAT_IDS,
# TELEGRAM_VIEWER_CHAT_IDS, TELEGRAM_NOTIFICATION_CHAT_IDS, WEB_PASSWORD_HASH,
# SCRAPECREATORS_API_KEY, OPENAI_API_KEY and other configured provider credentials.
