# Lead Radar. По умолчанию работает в безопасном локальном режиме и НЕ тратит внешние токены.
TELEGRAM_BOT_TOKEN=
# Telegram user IDs for the web application. Each ID must belong to exactly one role.
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_MANAGER_CHAT_IDS=
TELEGRAM_VIEWER_CHAT_IDS=

# Второй предохранитель расходов. Даже если LIVE_CALLS_ENABLED=true, запросы не уйдут наружу,
# пока здесь не будет ровно ALLOW_EXTERNAL_CALLS. В безопасном тесте оставьте пустым.
EXTERNAL_LIVE_UNLOCK=
EXTERNAL_KILL_SWITCH=true

DATABASE_URL=sqlite+aiosqlite:///./lead_radar.db
DATABASE_BACKUP_ON_START=true
DATABASE_BACKUP_KEEP=10

# AI: rules = только локальные правила; hybrid = правила + OpenAI для неоднозначных; openai = OpenAI для всего.
AI_MODE=hybrid
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_LIVE_CALLS_ENABLED=false
OPENAI_DAILY_REQUEST_LIMIT=100
AI_PENDING_RETRY_ENABLED=true
AI_PENDING_RETRY_BATCH_SIZE=5
AI_PENDING_RETRY_COOLDOWN_SECONDS=3600
AI_REQUEST_LEASE_SECONDS=180
AI_REQUEST_MAX_ATTEMPTS=3
LEAD_ANALYSIS_VERSION=3.0

# Instagram. replay и mock не делают внешних запросов. replay удобнее: он воспроизводит реалистичный сценарий по шагам.
INSTAGRAM_PROVIDER=replay
REPLAY_FIXTURE_PATH=fixtures/replay_aiko.json
REPLAY_STATE_PATH=.runtime/replay_state.json
INSTAGRAM_LIVE_CALLS_ENABLED=false
INSTAGRAM_DAILY_REQUEST_LIMIT=100
INSTAGRAM_MAX_UNITS_PER_SCAN=8
INSTAGRAM_MANUAL_LIVE_SCAN_ONLY=true
# Общий выключатель поиска: false блокирует ручные, CLI и плановые циклы даже в replay.
LEAD_SEARCH_ENABLED=false
MONITOR_SCHEDULE_ENABLED=false
INSTAGRAM_AUTO_REPAIR_PARTIAL_COVERAGE=false
INSTAGRAM_BASELINE_MAX_COMMENT_PAGES=1
INSTAGRAM_INCREMENTAL_MAX_COMMENT_PAGES=2
SCRAPECREATORS_API_KEY=
SCRAPECREATORS_API_URL=https://api.scrapecreators.com
SCRAPECREATORS_MAX_COMMENT_PAGES=10
BRIGHTDATA_API_KEY=
BRIGHTDATA_API_URL=https://api.brightdata.com/datasets/v3/scrape
BRIGHTDATA_PROFILE_DATASET_ID=gd_l1vikfch901nx3by4
BRIGHTDATA_POSTS_DATASET_ID=gd_lk5ns7kz21pck8jpis
BRIGHTDATA_REELS_DATASET_ID=gd_lyclm20il4r5helnj
BRIGHTDATA_COMMENTS_DATASET_ID=gd_ltppn085pokosxh13

# Bootstrap-список для обратной совместимости. Полная карта конкурентов хранится в БД и
# автоматически синхронизируется из встроенного каталога. Новые компании стартуют на паузе.
COMPETITORS=aiko.uz
HOT_LEAD_THRESHOLD=70
INSTAGRAM_POLL_INTERVAL_SECONDS=180
INSTAGRAM_FORCE_REFRESH_SECONDS=3600
PROCESS_EXISTING_COMMENTS=false
INSTAGRAM_SIGNAL_MAX_AGE_DAYS=30
INSTAGRAM_AUTO_ANALYZE_FRESH_BATCH_SIZE=10
ANALYZE_BASELINE_COMMENTS=false
HISTORICAL_ANALYSIS_BATCH_SIZE=0

WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_PUBLIC_URL=
# ID менеджера для локального режима без Telegram auth. 0 = кнопки воронки и POST /api/* заблокированы.
WEB_MANAGER_ID=1
# Public WEB_HOST/WEB_PUBLIC_URL is rejected unless auth is enabled, an HTTPS public URL is
# configured, and TELEGRAM_BOT_TOKEN plus at least one role ID are present.
WEB_AUTH_ENABLED=false
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300

HTTP_TIMEOUT_SECONDS=60
HTTP_MAX_ATTEMPTS=3
TELEGRAM_NOTIFICATION_MAX_ATTEMPTS=3
TELEGRAM_NOTIFICATION_FLUSH_INTERVAL_SECONDS=30
TELEGRAM_NOTIFICATION_LEASE_SECONDS=120
NOTIFICATION_POLICY=ALL_NEW_COMMENTS

# Meta Ads (Marketing API). Live calls требуют EXTERNAL_KILL_SWITCH=false и EXTERNAL_LIVE_UNLOCK=ALLOW_EXTERNAL_CALLS.
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=
META_ADS_LIVE_CALLS_ENABLED=false
LOG_LEVEL=INFO
# text | json — structured logs для production (см. docs/DEPLOYMENT.md)
LOG_FORMAT=text
# Опционально: pip install sentry-sdk
SENTRY_DSN=
